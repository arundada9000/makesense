# Copy to .env.local and fill in only what applies to your deployment.
# MakeSense runs fully local-first; no API keys are required to develop or ship.

# Optional: base URL for canonical URLs when not deploying to Vercel.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google AdSense publisher ID (ad unit script is embedded in layout).
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Optional: Google Search Console verification token (also set in app/layout.tsx).
# NEXT_PUBLIC_GSC_VERIFICATION=your-verification-code